# Database Configuration (Defaults to local SQLite if unset, or PostgreSQL for production)
DATABASE_URL=sqlite:///./mining_rover.db
# DATABASE_URL=postgresql://mining_user:mining_secure_password_2026@localhost:5432/mining_rover

# Authentication & Security
JWT_SECRET=super-secret-mining-rover-jwt-key-2026-secure
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Machine Learning Model
ML_MODEL_PATH=app/ml/artifacts/random_forest_model.joblib
ML_METRICS_PATH=app/ml/artifacts/model_metrics.json

# Live Video Stream (ESP32-CAM)
CAMERA_STREAM_URL=

# Frontend URLs
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws/live
